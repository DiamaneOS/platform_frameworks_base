// Client of the decode service (de.diamaneos.sanitizer): images that other apps hand to the system server or
// SystemUI are decoded in a protected VM and come back as checked pixels. The AIDL files are a copy of the service
// contract (sanitizer repository, branch service-api), the same copy MediaProvider compiles.

package {
    default_applicable_licenses: ["frameworks_base_license"],
}

// Widgets on the glanceable hub rely on remote_adapter_conversion: with it on, a widget's app sends its list items
// inside the update, where they are checked, and the system refuses to let SystemUI fetch rows from the app's service.
// The build stops when the flag is not a fixed true in this release (read from the generated flag code), so a release
// config change cannot open that path without anyone noticing. The walker refuses the old list actions in any case.
java_genrule {
    name: "diamaneos-remote-adapter-conversion-check",
    srcs: [":android.appwidget.flags-aconfig-java{.generated_srcjars}"],
    tools: ["zipsync"],
    out: ["RemoteAdapterConversionChecked.java"],
    cmd: "$(location zipsync) -d $(genDir)/flags -l $(genDir)/flags.list $(in)" +
        " && grep -A2 'boolean remoteAdapterConversion()' $(genDir)/flags/android/appwidget/flags/Flags.java" +
        " | grep -q 'return true;'" +
        " || { echo 'remote_adapter_conversion must be a fixed true in this release (hub widget lists)' >&2; exit 1; }" +
        " && printf 'package de.diamaneos.decode.client;\\n\\n" +
        "/** Generated by the build: remote_adapter_conversion is a fixed true in this release. */\\n" +
        "final class RemoteAdapterConversionChecked {\\n    private RemoteAdapterConversionChecked() {\\n    }\\n}\\n'" +
        " > $(out)",
}

// The copy of the decode service's API this library compiles: its AIDL files and DecodeChecks. The service's
// build compares them byte for byte with its originals (decode_api_copies_check), so a copy that drifts fails the
// build.
filegroup {
    name: "framework-decode-api-copy",
    srcs: [
        "aidl/de/diamaneos/sanitizer/decode/*.aidl",
        "java/de/diamaneos/sanitizer/decode/DecodeChecks.java",
    ],
    visibility: ["//packages/apps/DiamaneOSSanitizer"],
}

java_library {
    name: "diamaneos-decode-client",
    srcs: [
        "java/**/*.java",
        "aidl/**/*.aidl",
        ":diamaneos-remote-adapter-conversion-check",
    ],
    aidl: {
        local_include_dirs: ["aidl"],
    },
    libs: ["framework"],
    sdk_version: "core_platform",
    visibility: [
        "//frameworks/base/services/core",
        "//frameworks/base/services/autofill",
        "//frameworks/base/services/companion",
        "//frameworks/base/packages/SystemUI:__subpackages__",
        "//frameworks/base/libs/WindowManager/Shell",
    ],
}

// The reply checks, the nine-patch chunk reader, the decode plan, the system image paths, the image caps, the per-app
// quota and pixel pool, the retry waits, the wallpaper box and the clean copy file format are plain Java, tested on
// the host.
java_test_host {
    name: "diamaneos-decode-client-tests",
    srcs: [
        "tests/src/**/*.java",
        "java/de/diamaneos/decode/client/Backoff.java",
        "java/de/diamaneos/decode/client/CallPool.java",
        "java/de/diamaneos/decode/client/CleanImageFile.java",
        "java/de/diamaneos/decode/client/ImageBudget.java",
        "java/de/diamaneos/decode/client/ImagePlan.java",
        "java/de/diamaneos/decode/client/NinePatchChunk.java",
        "java/de/diamaneos/decode/client/OwnerPixels.java",
        "java/de/diamaneos/decode/client/OwnerQuota.java",
        "java/de/diamaneos/decode/client/StripeValidator.java",
        "java/de/diamaneos/decode/client/SystemImagePaths.java",
        "java/de/diamaneos/decode/client/WallpaperBox.java",
    ],
    static_libs: ["junit"],
    test_options: {
        unit_test: true,
    },
}

// On the phone: every Icon type through VmIcons and the notification gate, the main-thread refusal, and the app's
// own layouts (every image action and Bundle, nested layouts, images named in layout XML through a test layout of this
// APK, a probe view and a native-decode oracle, the image cap, the VM down, the image threads, app XML icons). Runs
// without the decode service too (images are then empty within the budget).
android_test {
    name: "DiamaneOSDecodeClientTests",
    srcs: ["tests/device/src/**/*.java"],
    resource_dirs: ["tests/device/res"],
    manifest: "tests/device/AndroidManifest.xml",
    static_libs: [
        "diamaneos-decode-client",
        "androidx.test.runner",
        "androidx.test.ext.junit",
        "junit",
    ],
    platform_apis: true,
    certificate: "platform",
    test_suites: ["device-tests"],
}
