# Calls of Android's image decoders in frameworks/base that stay, for the decode service's
# tools/check-no-android-decoders.sh, run from the frameworks/base checkout:
#   check-no-android-decoders.sh diamaneos/decode-client/tools/android-decoders-frameworks.allow packages/SystemUI/src
#   libs/WindowManager/Shell/src services/core/java/com/android/server/notification
#   services/core/java/com/android/server/wallpaper
# None of them decodes an image another app handed over.
packages/SystemUI/src/com/android/systemui/DessertCaseView.java: loaded = BitmapFactory.decodeResource(res, resid, opts) # SystemUI's own resources (the easter egg)
packages/SystemUI/src/com/android/systemui/globalactions/GlobalActionsDialogLite.java: Drawable.createFromPath(user.iconPath) # the user's own picture, a file the system wrote
packages/SystemUI/src/com/android/systemui/screenrecord/ScreenMediaRecorder.java: ThumbnailUtils.createVideoThumbnail( # SystemUI's own screen recording
packages/SystemUI/src/com/android/systemui/screenshot/scroll/ImageLoader.java: result.mBitmap = BitmapFactory.decodeStream(in) # SystemUI's own scroll capture files
packages/SystemUI/src/com/android/systemui/statusbar/policy/SmartReplyStateInflater.kt: "ImageDecoder.decodeBitmap() returned null" # a log text, the decode is VmIcons.decode
services/core/java/com/android/server/wallpaper/WallpaperCropper.java: Bitmap cropped = ImageDecoder.decodeBitmap(source, (decoder, info, src) -> { # the system image's default wallpaper (openRawDefaultWallpaper)
services/core/java/com/android/server/wallpaper/WallpaperCropper.java: BitmapFactory.decodeFile(wallpaper.getWallpaperFile().getAbsolutePath(), options) # only a clean copy made in the VM (WallpaperVmSanitizer.isClean guards generateCropInternal)
services/core/java/com/android/server/wallpaper/WallpaperCropper.java: Bitmap cropped = ImageDecoder.decodeBitmap(srcData, (decoder, info, src) -> { # only a clean copy made in the VM (generateCropInternal)
services/core/java/com/android/server/wallpaper/WallpaperCropper.java: BitmapFactory.decodeFile(wallpaperFile.getAbsolutePath(), options) # only a clean copy made in the VM (WallpaperVmSanitizer.isClean just above)
