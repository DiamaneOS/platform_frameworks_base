<!-- A notification layout of the test app: images named in the layout XML itself. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vm_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vm_test_layers"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/vm_src_png"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vm_test_red" />

    <ImageView
        android:id="@+id/vm_src_bitmap_xml"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vm_test_bitmap" />

    <ImageView
        android:id="@+id/vm_src_nine"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/vm_test_nine" />

    <FrameLayout
        android:id="@+id/vm_nine_background"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:background="@drawable/vm_test_patch" />

    <ImageView
        android:id="@+id/vm_src_vector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vm_test_vector" />

    <TextView
        android:id="@+id/vm_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/vm_test_blue"
        android:text="text" />

    <ImageView
        android:id="@+id/vm_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageView
        android:id="@+id/vm_target_night"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/vm_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
</LinearLayout>
