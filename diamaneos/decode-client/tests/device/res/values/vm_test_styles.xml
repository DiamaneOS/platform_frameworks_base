<resources>
    <!-- A splash theme whose images are this APK's bitmap files (SplashImagesDeviceTest). -->
    <style name="VmTestSplash" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/vm_test_red</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/vm_test_bitmap</item>
        <item name="android:windowBackground">@drawable/vm_test_layers</item>
    </style>

    <!-- The same with a vector splash icon: XML only, nothing to make. -->
    <style name="VmTestSplashVector" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/vm_test_vector</item>
        <item name="android:windowSplashScreenBackground">#ff102030</item>
    </style>
</resources>
