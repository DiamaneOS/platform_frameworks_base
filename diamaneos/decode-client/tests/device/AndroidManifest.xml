<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.diamaneos.decode.client.tests">
    <!-- PostTimeDeviceTest posts a notification as an app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- UserSwitchDialogDeviceTest gives a test user an icon for the user switching dialog. -->
    <uses-permission android:name="android.permission.MANAGE_USERS" />
    <!-- WallpaperVmDeviceTest sets a wallpaper and reads back whether its crop was made. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.READ_WALLPAPER_INTERNAL" />
    <!-- ListsAndQueueDeviceTest checks URI access as SystemUI does: the platform answers that check only for a
         caller that may act across users. -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <!-- VmPathDeviceTest reaches the decode service: the permission is the platform's signature, and the service
         takes this package as a caller on debuggable builds only. -->
    <uses-permission android:name="de.diamaneos.sanitizer.permission.DECODE" />
    <!-- CardDecisionsDeviceTest asks for adoptable storage, which must be refused, and ObbLifecycleDeviceTest ejects
         and mounts the SD card. -->
    <uses-permission android:name="android.permission.MOUNT_FORMAT_FILESYSTEMS" />
    <uses-permission android:name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS" />
    <!-- TaskIconOwnerDeviceTest reads another user's recent tasks and a task icon it did not make. -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
    <!-- The phone checks host a conversation widget of SystemUI (ProofWidgetHostActivity). -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <!-- ClientContextDeviceTest makes a package context of another app. -->
    <queries>
        <package android:name="com.android.systemui" />
        <package android:name="de.diamaneos.archive.icon.fixture" />
    </queries>
    <application>
        <activity android:name="de.diamaneos.decode.client.AudienceHomeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Counts opens, so a test sees whether a URI was opened at all. -->
        <provider
            android:name="de.diamaneos.decode.client.ProbeProvider"
            android:authorities="de.diamaneos.decode.client.tests.probe"
            android:grantUriPermissions="true"
            android:exported="false" />
        <!-- An image whose colour names the user it was opened in (AutofillViewsDeviceTest). -->
        <provider
            android:name="de.diamaneos.decode.client.UserImageProvider"
            android:authorities="de.diamaneos.decode.client.tests.user"
            android:exported="true" />
        <!-- Thumbnails for ContentResolver.loadThumbnail (ThumbnailsDeviceTest). -->
        <provider
            android:name="de.diamaneos.decode.client.ThumbnailTestProvider"
            android:authorities="de.diamaneos.decode.client.tests.thumbnails"
            android:exported="false" />
        <!-- A task with an icon of its own, started in a work profile (TaskIconOwnerDeviceTest). -->
        <activity
            android:name="de.diamaneos.decode.client.TaskIconActivity"
            android:exported="false" />
        <!-- A task in a process of its own, ended by the test so its snapshot is loaded from disk
             (SnapshotFilesDeviceTest). -->
        <activity
            android:name="de.diamaneos.decode.client.SnapshotTaskActivity"
            android:process=":snapshot"
            android:exported="false" />
        <!-- The phone checks of the UI fixes (PhoneProofsDeviceTest): an autofill service, a form for it and a
             host of SystemUI's conversation widget. -->
        <service
            android:name="de.diamaneos.decode.client.ProofAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>
        <activity
            android:name="de.diamaneos.decode.client.ProofFormActivity"
            android:exported="true" />
        <activity
            android:name="de.diamaneos.decode.client.ProofWidgetHostActivity"
            android:exported="true" />
        <!-- Conversation shortcuts need a launcher activity: on only while a phone check posts one (pm enable). -->
        <activity-alias
            android:name="de.diamaneos.decode.client.ProofLauncher"
            android:targetActivity="de.diamaneos.decode.client.ProofFormActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="de.diamaneos.decode.client.tests" />
</manifest>
