// Clean copies of apps' image files (the clean icon cache): the file format, the key, the client of the system
// server's store and the process image gate. Compiled into the framework (framework-non-updatable-sources), so every
// system process can take apps' images from clean copies made in the protected VM.

package {
    default_applicable_licenses: ["frameworks_base_license"],
}

filegroup {
    name: "diamaneos-clean-copies-sources",
    srcs: ["java/**/*.java"],
    visibility: ["//frameworks/base"],
}

// The file format, the key, who may see a user's copies, the mount rule of verified system files, and the decode
// gate's image owners and global locks are plain Java, tested on the host.
java_test_host {
    name: "diamaneos-clean-copies-tests",
    srcs: [
        "java/com/android/internal/diamaneos/cleancopies/ArchiveSource.java",
        "tests/src/**/*.java",
        "java/com/android/internal/diamaneos/cleancopies/CleanCopyKey.java",
        "java/com/android/internal/diamaneos/cleancopies/CleanImageFile.java",
        "java/com/android/internal/diamaneos/cleancopies/CopyMiss.java",
        "java/com/android/internal/diamaneos/cleancopies/CopyAudience.java",
        "java/com/android/internal/diamaneos/cleancopies/GateLocks.java",
        "java/com/android/internal/diamaneos/cleancopies/GateOwner.java",
        "java/com/android/internal/diamaneos/cleancopies/IconUsers.java",
        "java/com/android/internal/diamaneos/cleancopies/ImageAttempts.java",
        "java/com/android/internal/diamaneos/cleancopies/VerifiedMounts.java",
        "java/com/android/internal/diamaneos/cleancopies/ThumbnailAdmission.java",
    ],
    static_libs: ["junit"],
    test_options: {
        unit_test: true,
    },
}
