<!-- The Tally meter that SliderPreference draws on the expressive theme (SliderPreference
     .applyTallyMeter), as the prototype's meters (design/prototypes/tally, app.css .cl-meter,
     .vol-meter). Written by hand from the Tally token spec, whose token each value names: SettingsLib
     does not link the token library. -->
<resources>
    <!-- The meter's height: the prototype's Settings meter (.cl-meter), 40 dp. -->
    <dimen name="settingslib_tally_meter_height">40dp</dimen>
    <!-- Its corners: radius 8 (tally_radius_s), not a pill. -->
    <dimen name="settingslib_tally_meter_radius">8dp</dimen>
    <!-- The value's lamp tick across the meter: 4 dp, as the volume meter's (.vol-tick). -->
    <dimen name="settingslib_tally_meter_tick_width">4dp</dimen>
    <!-- The tick's edge in the lamp outline colour (hairline, 1 dp); in dark theme the lamp outline
         is the lamp itself. -->
    <dimen name="settingslib_tally_meter_tick_edge">1dp</dimen>
</resources>
