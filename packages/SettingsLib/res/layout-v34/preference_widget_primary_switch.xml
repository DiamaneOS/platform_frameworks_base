<!-- layout/preference_widget_primary_switch.xml with the Tally switch: a Switch that draws and
     moves as the Tally prototype's switch. From API 34, as the colour roles it reads. -->
<com.android.settingslib.widget.TallyFrameworkSwitch
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/switchWidget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="@dimen/two_target_min_width"
    android:gravity="center_vertical"
    android:clickable="false" />
