<!-- A Tally section card segment, the prototype's .set-sec and .set-row: a section's last row: a
     hairline above it, the card's sides and its rounded bottom, in the surface colour with the 1 dp
     hairline in outlineVariant and 12 dp outer corners, 12 dp from the screen's sides, with the
     row's content 28 dp in. No ripple: the plain background of switch rows, whose switch shows the
     press. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingStart="@dimen/settingslib_tally_row_inset"
    android:paddingEnd="@dimen/settingslib_tally_row_inset">
    <!-- The segment's outline, whole: draws nothing. -->
    <item
        android:start="@dimen/settingslib_tally_card_margin"
        android:end="@dimen/settingslib_tally_card_margin">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="@dimen/settingslib_tally_row_border_radius"
                android:bottomRightRadius="@dimen/settingslib_tally_row_border_radius" />
        </shape>
    </item>
    <item
        android:start="@dimen/settingslib_tally_card_margin"
        android:end="@dimen/settingslib_tally_card_margin">
        <shape android:shape="rectangle">
            <solid android:color="@color/settingslib_tally_surface" />
            <stroke
                android:width="@dimen/settingslib_tally_row_hairline"
                android:color="@color/settingslib_tally_outline_variant" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="@dimen/settingslib_tally_row_border_radius"
                android:bottomRightRadius="@dimen/settingslib_tally_row_border_radius" />
        </shape>
    </item>
</layer-list>
