<!-- The background of a Tally switch row: its section card segment by its place in the section,
     as settingslib_round_background_stateful, but with no ripple and no focus highlight, so the
     switch's press layer and focus ring are the row's only press and focus signals, as in the
     prototype. Outside the expressive adapter (no place set) the row has no background. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_single="true" android:drawable="@drawable/settingslib_tally_card" />
    <item android:state_first="true" android:drawable="@drawable/settingslib_tally_card_top" />
    <item android:state_middle="true" android:drawable="@drawable/settingslib_tally_card_center" />
    <item android:state_last="true" android:drawable="@drawable/settingslib_tally_card_bottom" />
    <item android:drawable="@android:color/transparent" />
</selector>
