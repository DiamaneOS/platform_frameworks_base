<!-- Tally: the selected row (the page open beside the list, in two panes) as a section card
     segment in stock's selected colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingMode="stack"
    android:paddingStart="@dimen/settingslib_tally_row_inset"
    android:paddingEnd="@dimen/settingslib_tally_row_inset">
    <!-- The segment's outline, whole: draws nothing. -->
    <item
        android:start="@dimen/settingslib_tally_card_margin"
        android:end="@dimen/settingslib_tally_card_margin"
        android:bottom="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:start="@dimen/settingslib_tally_card_margin"
        android:end="@dimen/settingslib_tally_card_margin"
        android:bottom="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/settingslib_materialColorSurfaceContainer" />
            <stroke
                android:width="@dimen/settingslib_tally_row_hairline"
                android:color="@color/settingslib_tally_outline_variant" />
        </shape>
    </item>
    <item>
        <ripple android:color="?android:colorControlHighlight">
            <item
                android:id="@android:id/mask"
                android:start="@dimen/settingslib_tally_card_margin"
                android:end="@dimen/settingslib_tally_card_margin">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/white" />
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
