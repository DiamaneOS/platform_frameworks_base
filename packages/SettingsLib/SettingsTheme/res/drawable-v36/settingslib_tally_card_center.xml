<!-- A Tally section card segment, the prototype's .set-sec and .set-row: a row inside a section:
     the card's sides and a hairline above the row, in the surface colour with the 1 dp hairline in
     outlineVariant and 12 dp outer corners, 12 dp from the screen's sides, with the row's content
     28 dp in. It reaches 3 dp below the row: across the 2 dp the list may leave between rows
     (SettingsBasePreferenceFragment's item spacing), with its bottom edge under the next row, which
     draws the hairline between them and carries the card on. No ripple: the plain background of
     switch rows, whose switch shows the press. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingStart="@dimen/settingslib_tally_row_inset"
    android:paddingEnd="@dimen/settingslib_tally_row_inset">
    <!-- The segment's outline, whole: draws nothing. -->
    <item
        android:start="@dimen/settingslib_tally_card_margin"
        android:end="@dimen/settingslib_tally_card_margin"
        android:bottom="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:start="@dimen/settingslib_tally_card_margin"
        android:end="@dimen/settingslib_tally_card_margin"
        android:bottom="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/settingslib_tally_surface" />
            <stroke
                android:width="@dimen/settingslib_tally_row_hairline"
                android:color="@color/settingslib_tally_outline_variant" />
        </shape>
    </item>
</layer-list>
