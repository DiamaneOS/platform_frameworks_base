<!-- Tally: the highlighted row (a search result) as a section card segment, with stock's accent
     at 26 % over it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingMode="stack"
    android:paddingStart="@dimen/settingslib_tally_row_inset"
    android:paddingEnd="@dimen/settingslib_tally_row_inset">
    <item android:drawable="@drawable/settingslib_tally_card_center" />
    <item
        android:start="@dimen/settingslib_tally_card_margin"
        android:end="@dimen/settingslib_tally_card_margin">
        <shape android:shape="rectangle" android:tint="?android:attr/colorAccent">
            <solid android:color="#42000000" />
        </shape>
    </item>
    <item>
        <ripple android:color="?android:colorControlHighlight">
            <item
                android:id="@android:id/mask"
                android:start="@dimen/settingslib_tally_card_margin"
                android:end="@dimen/settingslib_tally_card_margin">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/white" />
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
