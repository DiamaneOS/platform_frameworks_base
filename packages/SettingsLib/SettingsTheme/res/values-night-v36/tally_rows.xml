<!-- Tally rows and section cards, dark theme: the values that differ from
     res/values-v36/tally_rows.xml. -->
<resources>
    <!-- bg, dark theme -->
    <color name="settingslib_tally_background">@android:color/system_surface_container_lowest_dark</color>

    <!-- Regular text is weight 380 in dark theme (item and body inherit it). -->
    <style name="TextAppearance.SettingsLib.Tally" parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:fontFamily">sofia-sans</item>
        <item name="android:textFontWeight">380</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
