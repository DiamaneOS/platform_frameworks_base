<!-- Tally switch thumb: the outline colour when off, onLamp on the lamp when on. Disabled
     (for example by an admin or by Enhanced Confirmation Mode) it keeps its state's colour at
     the disabled-content opacity, so a switch that is on and cannot be changed still reads as
     on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true"
          android:color="@color/settingslib_tally_on_lamp"
          android:alpha="0.38" />
    <item android:state_enabled="false"
          android:color="@color/settingslib_tally_outline"
          android:alpha="0.38" />
    <item android:state_checked="true"
          android:color="@color/settingslib_tally_on_lamp" />
    <item android:color="@color/settingslib_tally_outline" />
</selector>
