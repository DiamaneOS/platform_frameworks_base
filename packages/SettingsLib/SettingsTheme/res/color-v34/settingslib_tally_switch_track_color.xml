<!-- Tally switch fill inside the border: surfaceHigh when off, the lamp when on. Disabled, the
     same colour at the disabled-content opacity. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true"
          android:color="@color/settingslib_tally_lamp"
          android:alpha="0.38" />
    <item android:state_enabled="false"
          android:color="@color/settingslib_tally_surface_high"
          android:alpha="0.38" />
    <item android:state_checked="true"
          android:color="@color/settingslib_tally_lamp" />
    <item android:color="@color/settingslib_tally_surface_high" />
</selector>
