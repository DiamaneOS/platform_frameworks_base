<!-- Tally rows and section cards for SettingsLib's expressive preference pages, as the Tally
     prototype's Settings pages draw them (design/prototypes/tally, app.css .set-sec, .set-row,
     .sec-h). Written by hand from the Tally token spec, whose token each value names:
     SettingsLib does not link the token library, and the generated export
     (res/values-v34/tally_switch.xml) holds only the switch and main switch row values, whose
     colours, radius and hairline these rows share. Dark theme: res/values-night-v36. -->
<resources>
    <!-- The page under the cards: bg (the token library's tally_background). -->
    <color name="settingslib_tally_background">@android:color/system_surface_container_low_light</color>

    <!-- A row is at least 64 dp tall, the prototype's .set-row (the token spec's row is 56 dp,
         for lock cards and lists; Settings rows are 64). -->
    <dimen name="settingslib_tally_row_min_height">64dp</dimen>
    <!-- Cards sit 12 dp from the screen's sides (space 12). -->
    <dimen name="settingslib_tally_card_margin">12dp</dimen>
    <!-- Row content starts 16 dp inside the card (space 16): 28 dp from the screen's side. -->
    <dimen name="settingslib_tally_row_inset">28dp</dimen>
    <!-- Above and below a row's text (space 8), inside the 64 dp minimum. -->
    <dimen name="settingslib_tally_row_padding_vertical">8dp</dimen>
    <!-- Row icons: 24 dp glyphs (icon), 16 dp before the text (space 16); an app icon may be up
         to 40 dp. -->
    <dimen name="settingslib_tally_icon_size">24dp</dimen>
    <dimen name="settingslib_tally_icon_max_size">40dp</dimen>
    <dimen name="settingslib_tally_icon_gap">16dp</dimen>
    <!-- A section title sits over its card, lined up with the rows' text: 16 dp from the side
         (the list's own padding) and this. -->
    <dimen name="settingslib_tally_section_title_inset">12dp</dimen>
    <!-- Where the main switch row's card starts, 12 dp from the side: the list gives every
         section-divider row 16 dp. -->
    <dimen name="settingslib_tally_main_switch_outset">-4dp</dimen>

    <!-- Line heights (sp, so they follow the text size): item 22, body 20, section 16. -->
    <dimen name="settingslib_tally_item_line_height">22sp</dimen>
    <dimen name="settingslib_tally_body_line_height">20sp</dimen>
    <dimen name="settingslib_tally_section_line_height">16sp</dimen>

    <!-- Type: Sofia Sans (the named family step 1 declares; sans-serif where it is absent).
         item: 16 sp, 400 (dark 380); body: 14 sp, 400 (dark 380); section: 11 sp, 500, +0.06 em,
         capitals. The colours are the stock state lists, whose roles are Tally's ink and muted
         (on_surface, on_surface_variant). -->
    <style name="TextAppearance.SettingsLib.Tally" parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:fontFamily">sofia-sans</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.SettingsLib.Tally.Item">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/settingslib_text_color_primary</item>
    </style>
    <style name="TextAppearance.SettingsLib.Tally.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/settingslib_text_color_secondary</item>
    </style>
    <style name="TextAppearance.SettingsLib.Tally.Section">
        <item name="android:textSize">11sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/settingslib_text_color_secondary</item>
    </style>
</resources>
