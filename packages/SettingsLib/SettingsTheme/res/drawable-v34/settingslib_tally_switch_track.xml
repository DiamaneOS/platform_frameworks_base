<!-- Tally switch track, for Switch, SwitchCompat and MaterialSwitch: the fill with the border
     over it. The padding, with the thumb's, sets where the thumb stops (see tally_switch.xml). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:constantSize="true">
    <!-- Disabled, the fill and the border are both see-through, so the fill stops at the
         border's inner edge instead of running under it. -->
    <item android:state_enabled="false">
        <layer-list
            android:paddingLeft="@dimen/settingslib_tally_switch_track_padding"
            android:paddingRight="@dimen/settingslib_tally_switch_track_padding">
            <item
                android:left="@dimen/settingslib_tally_switch_border_width"
                android:top="@dimen/settingslib_tally_switch_border_width"
                android:right="@dimen/settingslib_tally_switch_border_width"
                android:bottom="@dimen/settingslib_tally_switch_border_width">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/settingslib_tally_switch_inner_radius" />
                    <solid android:color="@color/settingslib_tally_switch_track_color" />
                </shape>
            </item>
            <item android:drawable="@drawable/settingslib_tally_switch_border" />
        </layer-list>
    </item>
    <!-- Enabled, the fill ends under the middle of the opaque border, so its edge never shows
         outside it. -->
    <item>
        <layer-list
            android:paddingLeft="@dimen/settingslib_tally_switch_track_padding"
            android:paddingRight="@dimen/settingslib_tally_switch_track_padding">
            <item
                android:left="@dimen/settingslib_tally_switch_fill_inset"
                android:top="@dimen/settingslib_tally_switch_fill_inset"
                android:right="@dimen/settingslib_tally_switch_fill_inset"
                android:bottom="@dimen/settingslib_tally_switch_fill_inset">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/settingslib_tally_switch_border_radius" />
                    <solid android:color="@color/settingslib_tally_switch_track_color" />
                </shape>
            </item>
            <item android:drawable="@drawable/settingslib_tally_switch_border" />
        </layer-list>
    </item>
</selector>
