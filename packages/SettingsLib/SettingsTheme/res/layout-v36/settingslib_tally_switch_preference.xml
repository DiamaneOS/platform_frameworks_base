<!-- A Tally switch row: settingslib_expressive_preference.xml for a switch preference, whose row
     toggles the switch in its widget frame. Its section card has no ripple and the row draws no
     focus highlight, so the switch's press layer and focus ring are its one press and focus
     signal, as in the prototype. The row keeps its size, its touch target and its place in the
     focus order. -->
<com.android.settingslib.widget.DrawableStateLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:filterTouchesWhenObscured="false"
    android:theme="?expressivePreferenceTheme"
    style="?expressivePreferenceRootLayoutStyle"
    android:background="@drawable/settingslib_tally_card_stateful"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/settingslib_tally_row_min_height"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:clipToPadding="false">

        <include layout="@layout/settingslib_expressive_preference_icon_frame"/>
        <include layout="@layout/settingslib_expressive_preference_text_frame"/>

        <!-- Preference should place its actual preference widget here. -->
        <LinearLayout
            android:id="@android:id/widget_frame"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="@dimen/settingslib_expressive_space_medium3"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:orientation="vertical"/>
    </LinearLayout>

    <include layout="@layout/settingslib_expressive_preference_footer"/>

</com.android.settingslib.widget.DrawableStateLinearLayout>
