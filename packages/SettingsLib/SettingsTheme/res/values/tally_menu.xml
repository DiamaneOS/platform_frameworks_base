<!-- The Tally menu that a dropdown row's popup is (TallyDropDownSpinner), as the prototype's menus
     (design/prototypes/tally, app.css .mc-menu). Written by hand from the Tally token spec. -->
<resources>
    <!-- The least room between the popup and either side of the window (space 16). -->
    <dimen name="settingslib_tally_menu_margin">16dp</dimen>
    <!-- An entry is at least 48 dp tall, the prototype's menu entries (and the Storage menu's). -->
    <dimen name="settingslib_tally_menu_entry_min_height">48dp</dimen>
    <!-- Above and below an entry's words, so an entry that wraps keeps them off its edges
         (space 8, as a row's). -->
    <dimen name="settingslib_tally_menu_entry_padding_vertical">8dp</dimen>
</resources>
