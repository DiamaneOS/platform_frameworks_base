<!-- The Tally usage meter that SettingsLib's linear progress style and UsageProgressBarPreference
     draw (Battery's and Storage's bars), as the prototype's meters (design/prototypes/tally, app.css
     .cl-meter, .sh-bright) and SettingsLib's slider. Written by hand from the Tally token spec. -->
<resources>
    <!-- Its corners: radius 8 (tally_radius_s), not a pill. -->
    <dimen name="settingslib_tally_usage_meter_radius">8dp</dimen>
    <!-- The value's lamp tick across the meter: 4 dp, as the slider's and the volume meter's. -->
    <dimen name="settingslib_tally_usage_meter_tick_width">4dp</dimen>
    <!-- The tick's edge in the lamp outline colour (hairline, 1 dp); in dark theme the lamp outline
         is the lamp itself. -->
    <dimen name="settingslib_tally_usage_meter_tick_edge">1dp</dimen>
</resources>
