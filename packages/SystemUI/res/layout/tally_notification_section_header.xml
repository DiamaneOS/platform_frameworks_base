<!-- Tally: a notification section header, as the prototype's .sec-h. It takes the whole space
     between the last card of one section and the first card of the next: 16 dp, the words on the
     section type's 16 sp line, 8 dp (StackScrollAlgorithm starts it right under the card before
     it, and the card after it right under it). The stock layout (status_bar_notification_section_
     header) is 48 dp tall. The words and Silent's clear-all key take the header's full height to
     tap; the key is 56 dp wide at the end, as stock's, its cross on the words' line. -->
<com.android.systemui.statusbar.notification.stack.SectionHeaderView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:forceHasOverlappingRendering="false"
        android:clipChildren="false"
        >
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <!-- SectionHeaderView makes it the words' line and these paddings tall -->
            <TextView
                style="@style/TextAppearance.NotificationSectionHeaderLabel"
                android:id="@+id/header_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/tally_notification_section_header_padding_top"
                android:paddingBottom="@dimen/tally_notification_section_header_padding_bottom"
                android:focusable="true"
                android:forceHasOverlappingRendering="false"
                android:text="@string/notification_section_header_gentle"
            />

        </FrameLayout>
        <ImageView
            android:id="@+id/btn_clear_all"
            android:layout_width="@dimen/tally_notification_section_clear_all_width"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/tally_notification_section_header_padding_top"
            android:paddingBottom="@dimen/tally_notification_section_header_padding_bottom"
            android:src="@drawable/status_bar_notification_section_header_clear_btn"
            android:contentDescription="@string/accessibility_notification_section_header_gentle_clear_all"
            android:focusable="true"
            android:scaleType="center"
            android:tintMode="src_in"
            android:visibility="gone"
            android:forceHasOverlappingRendering="false"
        />
    </LinearLayout>

</com.android.systemui.statusbar.notification.stack.SectionHeaderView>
