<!-- A small key in the Tally power menu (the prototype's .pm-s): the action's icon over its word,
     for the actions that are not about the phone's power or lock (screenshot, bug report). -->
<com.android.systemui.globalactions.GlobalActionsItem
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/tally_power_menu_key_background"
    android:gravity="center"
    android:minHeight="@dimen/tally_power_menu_key_height"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/tally_space_xs"
    android:paddingVertical="@dimen/tally_space_s">

    <ImageView
        android:id="@*android:id/icon"
        android:layout_width="@dimen/tally_icon_size"
        android:layout_height="@dimen/tally_icon_size"
        android:layout_marginBottom="@dimen/tally_power_menu_key_gap"
        android:scaleType="centerInside"
        android:tint="@color/tally_ink" />

    <TextView
        android:id="@*android:id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:lineHeight="@dimen/tally_type_caption_line_height"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Tally.Caption"
        android:textColor="@color/tally_ink" />
</com.android.systemui.globalactions.GlobalActionsItem>
