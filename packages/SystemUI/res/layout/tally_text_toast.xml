<!-- The Tally toast (the prototype's .toast): the app's icon, when it has one, and the words on the
     inverse surface with the card radius and a light shadow. The ids, and what SystemUIToast fills
     in (the words, the app's icon and its label), are stock's (text_toast). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/tally_toast_background"
    android:elevation="@dimen/tally_toast_elevation"
    android:gravity="center_vertical"
    android:minHeight="@dimen/tally_toast_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/tally_toast_padding_start"
    android:paddingTop="@dimen/tally_toast_padding_vertical"
    android:paddingEnd="@dimen/tally_toast_padding_end"
    android:paddingBottom="@dimen/tally_toast_padding_vertical">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/tally_toast_icon_size"
        android:layout_height="@dimen/tally_toast_icon_size"
        android:layout_marginEnd="@dimen/tally_toast_gap" />

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:lineHeight="@dimen/tally_type_body_line_height"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Tally.Body"
        android:textColor="@color/tally_on_inverse" />
</LinearLayout>
