<!-- The notice that a device joined the Wi-Fi hotspot (com.android.systemui.tally.hotspot). -->
<resources>
    <!-- Whether the notice shows the names devices give themselves. A name is a claim and can
         be false. -->
    <bool name="tally_hotspot_join_notice_shows_names">true</bool>

    <!-- Notification channel for a device that joins for the first time since the hotspot
         was turned on. [CHAR LIMIT=40] -->
    <string name="tally_hotspot_join_channel_new">Hotspot: new device</string>
    <!-- Notification channel for a device that was connected before and joins again.
         [CHAR LIMIT=40] -->
    <string name="tally_hotspot_join_channel_returned">Hotspot: device returned</string>

    <!-- Title of the notice. The count is the number of devices that joined.
         [CHAR LIMIT=50] -->
    <string name="tally_hotspot_join_title">{count, plural,
        =1 {A device joined your hotspot}
        other {# devices joined your hotspot}
    }</string>
    <!-- Text of the notice. The count is the number of names. They are what the devices call
         themselves: do not word it as a fact about who joined. [CHAR LIMIT=NONE] -->
    <string name="tally_hotspot_join_names">{count, plural,
        =1 {Name given: {names}}
        other {Names given: {names}}
    }</string>
</resources>
