<!-- Text the Moments switch shows (com.android.systemui.tally.moments). -->
<resources>
    <!-- Toast after the Moments switch turns Moments on -->
    <string name="tally_moments_toast_on">Moments on</string>
    <!-- Toast after the Moments switch turns Moments off -->
    <string name="tally_moments_toast_off">Moments off</string>
    <!-- Toast after the Moments switch blocks camera and microphone access (a software
         setting, not a hardware cut-off) -->
    <string name="tally_moments_toast_sensors_blocked">Camera and microphone access off</string>
    <!-- Toast after the Moments switch gives camera and microphone access back -->
    <string name="tally_moments_toast_sensors_unblocked">Camera and microphone access on</string>
    <!-- Toast after the Moments switch blocks camera access only (the phone offers no
         microphone toggle) -->
    <string name="tally_moments_toast_camera_blocked">Camera access off</string>
    <!-- Toast after the Moments switch gives camera access back -->
    <string name="tally_moments_toast_camera_unblocked">Camera access on</string>
    <!-- Toast after the Moments switch blocks microphone access only -->
    <string name="tally_moments_toast_mic_blocked">Microphone access off</string>
    <!-- Toast after the Moments switch gives microphone access back -->
    <string name="tally_moments_toast_mic_unblocked">Microphone access on</string>
    <!-- Toast after the Moments switch silences the ringer -->
    <string name="tally_moments_toast_silent_on">Silent mode on</string>
    <!-- Toast after the Moments switch restores the ringer -->
    <string name="tally_moments_toast_silent_off">Silent mode off</string>
    <!-- Toast after the Moments switch turns airplane mode on -->
    <string name="tally_moments_toast_airplane_on">Airplane mode on</string>
    <!-- Toast after the Moments switch turns airplane mode off -->
    <string name="tally_moments_toast_airplane_off">Airplane mode off</string>
    <!-- Toast after the Moments switch locks the phone down -->
    <string name="tally_moments_toast_lockdown">Locked down</string>
    <!-- Toast when the Moments switch is turned back on the lock screen: changes that lower
         protection wait for the unlock -->
    <string name="tally_moments_toast_after_unlock">The rest changes back after you unlock</string>

    <!-- Dialog text when an app tries the microphone while the Moments switch blocks it in the
         kernel; there is no unblock button -->
    <string name="tally_moments_mic_blocked_by_switch">The Moments switch turns the microphone off. To use it, slide the switch back.</string>
    <!-- Same, for the camera -->
    <string name="tally_moments_camera_blocked_by_switch">The Moments switch turns the camera off. To use it, slide the switch back.</string>
    <!-- Same, for the camera and the microphone -->
    <string name="tally_moments_mic_camera_blocked_by_switch">The Moments switch turns the camera and microphone off. To use them, slide the switch back.</string>

    <!-- Title of the one-time notification when the switch is on before the user chose what it
         does -->
    <string name="tally_moments_notice_title">Moments switch is on</string>
    <!-- Text of that notification; tapping it opens the Moments switch settings -->
    <string name="tally_moments_notice_text">Choose what it does</string>

    <!-- Title of the dialog when the user opens an app that Moments paused -->
    <string name="tally_moments_paused_title">Paused for Moments</string>
    <!-- Text of that dialog -->
    <string name="tally_moments_paused_message">This app is paused while the Moments switch is on.</string>
</resources>
