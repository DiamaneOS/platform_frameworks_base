<!-- Sizes only the Tally notification section headers use (the prototype's .nsec and .sec-h). -->
<resources>
    <!-- The space under a section's last card before the next section's header (.nsec's 4 dp
         margin). The header then adds its own 12 dp, so the words start 16 dp under the card. -->
    <dimen name="tally_notification_section_margin">@dimen/tally_space_xs</dimen>
    <!-- The space a header keeps above its words (.sec-h's 12 dp). Under the words there is only
         the 8 dp every card keeps from the next, as .sec-h's 8 dp. -->
    <dimen name="tally_notification_section_header_padding_top">@dimen/tally_space_m</dimen>
    <!-- The header's words sit 4 dp in from the cards' edge (.sec-h's side padding) -->
    <dimen name="tally_notification_section_header_padding_side">@dimen/tally_space_xs</dimen>
</resources>
