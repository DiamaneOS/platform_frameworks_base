<!-- Tally's overrides of SystemUI's config.xml, and new device switches with their stock
     default. -->
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Doze: drop a single or double tap while the proximity sensor is covered. For tap
     sensors that do not reject pocket touches themselves. The non-wake-up proximity sensor
     then reports five times a second while these gestures listen, and a tap without a current
     reading waits up to 0.4 s for the next one.
     The user can turn this off with Pocket check in Settings. -->
    <bool name="doze_proximity_check_before_tap">false</bool>

    <!-- Tally: an expanded group stays one card, its children inside it -->
    <bool xmlns:android="http://schemas.android.com/apk/res/android"
        name="config_showGroupNotificationBgWhenExpanded"
        android:featureFlag="de.diamaneos.systemui.tally_shell">true</bool>

    <!-- Whether the vertical volume dialog is shown on the left edge of the screen, next to
         volume buttons on the left side of the device. The dialog layout is mirrored. -->
    <bool name="config_volumeDialogOnLeft">false</bool>
</resources>
