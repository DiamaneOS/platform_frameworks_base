<!-- Text the lock screen shows while a new passphrase or generated PIN is practised
     (com.android.systemui.bouncer). -->
<resources>
    <!-- First line on the lock screen's password entry, in place of "Enter password", while
         the line under it asks for the passphrase for practice. [CHAR LIMIT=48] -->
    <string name="tally_lock_practice_enter_passphrase">Enter passphrase</string>
    <!-- Second line on the lock screen's password entry, in place of "Added security required.
         Password not used for a while.", while a newly set passphrase is asked for once a day
         so that the user learns it. The count is the days of practice left, rounded up; the
         last day reads without a number. [CHAR LIMIT=70] -->
    <string name="tally_lock_practice_passphrase">{count, plural,
        =1 {Last day of practice: type your passphrase.}
        other {Daily practice: type your passphrase. # more days.}
    }
    </string>
    <!-- Second line on the lock screen's PIN entry, in place of "Added security required. PIN
         not used for a while.", while a newly set long random PIN is asked for once a day so
         that the user learns it. The count is the days of practice left, rounded up; the last
         day reads without a number. [CHAR LIMIT=70] -->
    <string name="tally_lock_practice_pin">{count, plural,
        =1 {Last day of practice: type your PIN.}
        other {Daily practice: type your PIN. # more days.}
    }
    </string>
</resources>
