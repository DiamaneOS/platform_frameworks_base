<!-- Sizes and ids only the Tally power menu and toasts use. -->
<resources>
    <!-- The power menu's sheet (the prototype's .pm): 240 dp wide, 8 dp from the power key's edge
         and every other edge, 8 dp inside -->
    <dimen name="tally_power_menu_width">240dp</dimen>
    <dimen name="tally_power_menu_margin">8dp</dimen>
    <dimen name="tally_power_menu_padding">8dp</dimen>
    <!-- How far the sheet slides out of the power key (the prototype's 260 dp) -->
    <dimen name="tally_power_menu_travel">260dp</dimen>
    <!-- The shadow under the sheet: the prototype's one ambient shadow, as elevation -->
    <dimen name="tally_power_menu_elevation">2dp</dimen>
    <!-- A row: icon, then its words; 14 dp between them, 6 and 12 dp inside -->
    <dimen name="tally_power_menu_row_gap">14dp</dimen>
    <dimen name="tally_power_menu_row_padding_vertical">6dp</dimen>
    <dimen name="tally_power_menu_row_padding_horizontal">12dp</dimen>
    <!-- A small key (screenshot, bug report): 64 dp tall, its icon over its word -->
    <dimen name="tally_power_menu_key_height">64dp</dimen>
    <dimen name="tally_power_menu_key_gap">2dp</dimen>

    <!-- Marks a power menu item drawn as a small key -->
    <item type="id" name="tally_power_menu_key" />
    <!-- The spring that slides the power menu's sheet -->
    <item type="id" name="tally_power_menu_spring" />
</resources>
