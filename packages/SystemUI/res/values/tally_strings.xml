<!-- Tally's strings for upstream SystemUI views, and the flagged fallback clock id. -->
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Tally: section title for what is going on now: live updates, calls and ongoing
         foreground services. [CHAR LIMIT=40] -->
    <string name="notification_section_header_live">Live</string>

    <!-- Tally: name of the default wallpaper in Wallpaper & style: stone-coloured paper with a
         fine grain, light or dark with the theme. [CHAR LIMIT=30] -->
    <string name="tally_wallpaper_label">Paper</string>

    <!-- Tally: the Tally lock clock (TallyClocks.TALLY_CLOCK_ID in the shared clock library) -->
    <string xmlns:android="http://schemas.android.com/apk/res/android"
        name="lockscreen_clock_id_fallback" translatable="false"
        android:featureFlag="de.diamaneos.systemui.tally_shell">TALLY</string>
</resources>
