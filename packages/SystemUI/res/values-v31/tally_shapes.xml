<!-- Tally shapes for values that SettingsLib defines in values-v31, where SystemUI's own
     unqualified values never apply: only a v31 value in SystemUI takes their place. -->
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The rows of the Quick Settings dialogs drawn with SettingsLib's switch bar backgrounds:
         the connected network in Internet, the devices in Bluetooth, the hearing device spinner.
         Tally draws them with the key radius, as the dialog keys and the selected-row ripple,
         instead of pills. -->
    <dimen name="settingslib_switch_bar_radius"
        android:featureFlag="de.diamaneos.systemui.tally_shell">@dimen/tally_radius_s</dimen>
</resources>
