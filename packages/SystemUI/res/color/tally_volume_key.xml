<!-- A Tally volume key that is not lit: no fill. It is the lamp colour at no alpha rather than
     transparent black, so a key that lights or goes out fades in the lamp colour instead of
     passing through a dark tint. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/tally_lamp" android:alpha="0" />
</selector>
