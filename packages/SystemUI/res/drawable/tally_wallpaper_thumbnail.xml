<!-- The plain wallpaper's thumbnail in Wallpaper & style: the page colour of the light theme
     above, the dark theme's below, split on the diagonal (tally_background's two values). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="240dp"
    android:viewportWidth="108"
    android:viewportHeight="240">
    <path
        android:fillColor="@android:color/system_surface_container_low_light"
        android:pathData="M0,0H108L0,240Z" />
    <path
        android:fillColor="@android:color/system_surface_container_lowest_dark"
        android:pathData="M108,0V240H0Z" />
</vector>
