<!-- The Paper wallpaper's thumbnail in Wallpaper & style: the light paper above, the dark paper
     below, split on the diagonal, each its own gradient (the Sodium values; the grain and the
     vignette are left out at this size). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="240dp"
    android:viewportWidth="108"
    android:viewportHeight="240">
    <path android:pathData="M0,0H108L0,240Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="240"
                android:startColor="@color/tally_paper_light_top"
                android:endColor="@color/tally_paper_light_bottom" />
        </aapt:attr>
    </path>
    <path android:pathData="M108,0V240H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="240"
                android:startColor="@color/tally_paper_dark_top"
                android:endColor="@color/tally_paper_dark_bottom" />
        </aapt:attr>
    </path>
</vector>
