<!-- Tally: the state lamp at the end of a notification long-press option's label. As on the
     prototype's permission keys, the lamp is lit only on the chosen option (the option row is
     selected): a disc in the lamp colour, edged in the lamp outline colour in light theme, at the
     large lamp size. Other options keep the same room with nothing drawn, so the label does not
     move when the choice changes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <size
                android:width="@dimen/tally_lamp_size_large"
                android:height="@dimen/tally_lamp_size_large" />
            <solid android:color="@color/tally_lamp" />
            <stroke
                android:width="@dimen/tally_stroke_hairline"
                android:color="@color/tally_lamp_outline" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size
                android:width="@dimen/tally_lamp_size_large"
                android:height="@dimen/tally_lamp_size_large" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
