<!-- The Emergency row in the Tally power menu: outlined in the error colour (1.5 dp, as the
     prototype's), with stock's press ripple inside it. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tally_radius_m" />
            <stroke
                android:width="@dimen/tally_stroke_lit_edge"
                android:color="@color/tally_error" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tally_radius_m" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</ripple>
