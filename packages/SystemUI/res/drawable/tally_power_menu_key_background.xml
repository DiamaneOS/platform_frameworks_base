<!-- A small key in the Tally power menu: the high surface with the card radius, and stock's press
     ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tally_radius_m" />
            <solid android:color="@color/tally_surface_high" />
        </shape>
    </item>
</ripple>
