// DiamaneOS flags for SystemUI. They are declared and linked like SystemUI's
// own flags in the parent directory, but in an aconfig package of their own,
// so they sit in this directory: the parent's *.aconfig only takes
// com.android.systemui. SystemUI code reads tally_shell through
// com.android.systemui.tally.TallyShell, never through the generated class.

package {
    default_applicable_licenses: ["frameworks_base_packages_SystemUI_license"],
    default_visibility: ["//frameworks/base/packages/SystemUI:__subpackages__"],
}

aconfig_declarations {
    name: "de_diamaneos_systemui_flags",
    package: "de.diamaneos.systemui",
    container: "system",
    srcs: [
        "*.aconfig",
    ],
}

java_aconfig_library {
    name: "de_diamaneos_systemui_flags_lib",
    aconfig_declarations: "de_diamaneos_systemui_flags",
    sdk_version: "system_current",
    // WM Shell (libs/WindowManager/Shell) reads the Tally flag too, for its motion.
    visibility: [
        "//frameworks/base/packages/SystemUI:__subpackages__",
        "//frameworks/base/libs/WindowManager/Shell:__pkg__",
    ],
}
