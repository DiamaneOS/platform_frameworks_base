<!-- Tally's bouncer styles: flagged overrides of stock styles. -->
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Tally: the same text in Sofia Sans at the regular weight, from the Tally body type -->
    <style name="Keyguard.TextView" parent="@android:style/Widget.DeviceDefault.TextView"
        android:featureFlag="de.diamaneos.systemui.tally_shell">
        <item name="android:textAppearance">@style/TextAppearance.Tally.Body</item>
        <item name="android:textSize">@dimen/kg_status_line_font_size</item>
        <item name="android:textColor">@color/materialColorOnSurface</item>
    </style>

    <!-- Tally: the prototype's outlined key, in the ink colour and the Tally label type -->
    <style name="Keyguard.TextView.EmergencyButton" parent="Theme.SystemUI"
        android:featureFlag="de.diamaneos.systemui.tally_shell">
        <item name="android:textAppearance">@style/TextAppearance.Tally.Label</item>
        <item name="android:textColor">@color/tally_ink</item>
        <item name="android:background">@drawable/tally_bouncer_outlined_key</item>
        <item name="android:paddingLeft">@dimen/tally_key_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/tally_key_padding_horizontal</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Tally: the password field is an outlined box with the key radius -->
    <style name="PasswordTheme" parent="Theme.SystemUI"
        android:featureFlag="de.diamaneos.systemui.tally_shell">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:colorControlNormal">?android:attr/textColorPrimary</item>
        <item name="android:colorControlActivated">?android:attr/textColorPrimary</item>
        <item name="android:editTextBackground">@drawable/tally_bouncer_password_field</item>
        <!-- the password field's text (its layout sets this appearance) in Sofia Sans -->
        <item name="android:textAppearanceMedium">@style/TextAppearance.Tally.Item</item>
    </style>
</resources>
