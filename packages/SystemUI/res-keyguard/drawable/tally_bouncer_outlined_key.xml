<!-- Tally: the prototype's outlined key (key-outline): no fill, a hairline in the outline colour
     and the key radius, with the Tally press colour as its ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/tally_press">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/tally_radius_s" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/tally_radius_s" />
            <stroke
                android:width="@dimen/tally_stroke_hairline"
                android:color="@color/tally_outline" />
        </shape>
    </item>
</ripple>
