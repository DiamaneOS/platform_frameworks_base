<!-- Tally: the bouncer's password field as the prototype draws it (bn-field): the background
     colour inside a 2 dp outline with the key radius; focused, the outline takes the accent and a
     3 dp ring of the accent at 35 % shows around it. The box sits 3 dp inside the view, focused or
     not, so the ring has room and the box never moves. The text sits 16 dp inside the view. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tally_bouncer_field_halo" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
            <item
                android:left="3dp"
                android:top="3dp"
                android:right="3dp"
                android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tally_background" />
                    <corners android:radius="@dimen/tally_radius_s" />
                    <stroke
                        android:width="@dimen/tally_stroke_control"
                        android:color="@color/tally_accent" />
                    <padding
                        android:left="13dp"
                        android:top="13dp"
                        android:right="13dp"
                        android:bottom="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <inset android:inset="3dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/tally_background" />
                <corners android:radius="@dimen/tally_radius_s" />
                <stroke
                    android:width="@dimen/tally_stroke_control"
                    android:color="@color/tally_outline" />
                <padding
                    android:left="13dp"
                    android:top="13dp"
                    android:right="13dp"
                    android:bottom="13dp" />
            </shape>
        </inset>
    </item>
</selector>
